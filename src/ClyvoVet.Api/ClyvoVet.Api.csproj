<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1573</NoWarn>
    <UserSecretsId>27cb80f1-031d-4bc6-83f6-9b9d84a231a8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.18.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <!-- 2.12.2, e nao 2.4.1: GHSA-v5pm-xwqc-g5wc (alta) atinge >= 2.0.0-preview.11
         ate 2.7.4, e a correcao saiu na 2.7.5. Fica na ultima 2.x em vez de pular
         para a 3.x porque quem traz este pacote e o Swashbuckle.AspNetCore.Swagger
         10.1.7, que declara dependencia de Microsoft.OpenApi 2.4.1 — dentro da
         mesma major o contrato binario se mantem; a 3.x seria uma aposta. A
         referencia direta existe justamente para sobrepor a transitiva. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />

    <!-- Mantem o grafo do Microsoft.IdentityModel em 8.3.1: o JwtBearer 8.0.11 declara
         7.1.2 nos pacotes Protocols e Protocols.OpenIdConnect, e o resto do grafo
         (Tokens, JsonWebTokens, Logging) fica em 8.3.1. Convivem em execucao — a
         prova e o AutenticacaoJwtTests. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClyvoVet.Domain\ClyvoVet.Domain.csproj" />
    <ProjectReference Include="..\ClyvoVet.Application\ClyvoVet.Application.csproj" />
    <ProjectReference Include="..\ClyvoVet.Infrastructure\ClyvoVet.Infrastructure.csproj" />
  </ItemGroup>

</Project>
