<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1573</NoWarn>
    <UserSecretsId>27cb80f1-031d-4bc6-83f6-9b9d84a231a8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- O laco de notificacao de lembretes so e testavel de forma deterministica
         chamando-o direto; passar pelo BackgroundService exigiria esperar um
         Task.Delay e o teste ficaria dependente de tempo. -->
    <InternalsVisibleTo Include="ClyvoVet.Api.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ClyvoVet.Api.Tests.Unit\**" />
    <Content Remove="ClyvoVet.Api.Tests.Unit\**" />
    <EmbeddedResource Remove="ClyvoVet.Api.Tests.Unit\**" />
    <None Remove="ClyvoVet.Api.Tests.Unit\**" />
    <Compile Remove="ClyvoVet.Api.Tests.Integration\**" />
    <Content Remove="ClyvoVet.Api.Tests.Integration\**" />
    <EmbeddedResource Remove="ClyvoVet.Api.Tests.Integration\**" />
    <None Remove="ClyvoVet.Api.Tests.Integration\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.18.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <!-- 2.12.2, e nao 2.4.1: GHSA-v5pm-xwqc-g5wc (alta) atinge >= 2.0.0-preview.11
         ate 2.7.4, e a correcao saiu na 2.7.5. Fica na ultima 2.x em vez de pular
         para a 3.x porque quem traz este pacote e o Swashbuckle.AspNetCore.Swagger
         10.1.7, que declara dependencia de Microsoft.OpenApi 2.4.1 — dentro da
         mesma major o contrato binario se mantem; a 3.x seria uma aposta. A
         referencia direta existe justamente para sobrepor a transitiva. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />

    <!-- Valida o access token que a API Java emite (ValidadorDeTokenJwt).
         JA ESTAVA NO GRAFO, so nao declarado: Twilio 8.0.0 traz
         System.IdentityModel.Tokens.Jwt 8.3.1 transitivamente. A referencia
         direta e a MESMA versao, entao a resolucao nao muda em nada — ela
         apenas para de depender de um pacote que chega por acaso.

         Escolhido em vez de Microsoft.AspNetCore.Authentication.JwtBearer de
         proposito. O JwtBearer traria uma cadeia nova de Microsoft.IdentityModel
         para um grafo ja unificado em 8.3.1, e junto com ela o modelo de
         autenticacao do ASP.NET — [Authorize], FallbackPolicy, esquemas. Nada
         disso e necessario aqui: esta API so precisa LER a identidade, e quem
         decide negar e a camada de escopo. Usando so o handler, a validacao
         nao tem como interferir em /health, /metrics, /swagger ou nos webhooks. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.1" />
    <PackageReference Include="Telegram.Bot" Version="22.10.3" />
    <PackageReference Include="Twilio" Version="8.0.0" />

    <!-- PIN DE PACOTE TRANSITIVO, NAO E DEPENDENCIA DO CODIGO
         Nada aqui usa Microsoft.Bcl.Memory diretamente. Ele chega como
         Twilio 8.0.0 -> Microsoft.IdentityModel.Tokens 8.3.1 -> Bcl.Memory 9.0.0,
         e a 9.0.0 tem GHSA-73j8-2gch-69rq (negacao de servico, alta), corrigida na
         9.0.14. Nao havia como subir pela raiz: 8.0.0 ja e a ultima do Twilio.
         Declarar a versao aqui e o mecanismo do NuGet para elevar uma transitiva
         — a referencia direta sempre vence a resolucao. Some quando o Twilio
         atualizar a cadeia dele. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.19" />
  </ItemGroup>

</Project>
